  "item": [
    {
      "name": "Issue token by password",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"clientId\": {{client_id}},\n    \"clientSecret\": {{client_secret}},\n    \"username\": {{user_id}},\n    \"password\": {{password}},\n    \"grantType\": \"password\",\n    \"scopes\": {{payment_scopes}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://{{oauth-fqdn}}/oauth/token",
          "protocol": "http",
          "host": [
            "{{oauth-fqdn}}"
          ],
          "path": [
            "oauth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Issue token by cc",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Parse the response body as JSON",
              "const responseJson = pm.response.json();",
              "",
              "// Check if access_token exists in the response",
              "pm.test(\"Access token exists in the response\", function () {",
              "    pm.expect(responseJson).to.have.property('access_token');",
              "});",
              "",
              "// Set the access_token to the collection environment",
              "if (responseJson.access_token) {",
              "    pm.collectionVariables.set(\"access_token\", responseJson.access_token);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"client_id\": {{client_id}},\n    \"client_secret\": {{client_secret}},\n    \"grant_type\": \"client_credentials\",\n    \"scopes\": {{payment_scopes}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://{{oauth-fqdn}}/oauth/token",
          "protocol": "http",
          "host": [
            "{{oauth-fqdn}}"
          ],
          "path": [
            "oauth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Issue token for reader",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Parse the response body as JSON",
              "const responseJson = pm.response.json();",
              "",
              "// Check if access_token exists in the response",
              "pm.test(\"Access token exists in the response\", function () {",
              "    pm.expect(responseJson).to.have.property('access_token');",
              "});",
              "pm.test(\"Refresh token exists in the response\", function () {",
              "    pm.expect(responseJson).to.have.property('refresh_token');",
              "});",
              "",
              "// Set the access_token to the collection environment",
              "if (responseJson.refresh_token) {",
              "    pm.collectionVariables.set(\"refresh_token\", responseJson.refresh_token);",
              "}",
              "",
              "if (responseJson.access_token) {",
              "    pm.collectionVariables.set(\"access_token\", responseJson.access_token);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
